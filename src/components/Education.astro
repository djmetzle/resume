      padding-bottom: 0.75rem;
    }

    .achievements {
      padding: 0.5rem 0;
      padding-top: 0;
    }
  }

  @media print {
    section {
      display: grid;
      grid-template-columns: 1fr 3fr;
      gap: 1rem;
      margin-bottom: 0.75rem;
      page-break-inside: avoid;
      align-items: start;
    }

    .summary {
      text-align: right;
      padding: 0.3rem 0.6rem 0.3rem 0.3rem;

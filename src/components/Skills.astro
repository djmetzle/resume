<h2>Skill Set</h2>
<section class="skills">
  <div class="skill">
    <h3>Competencies</h3>
    <ul>
      <li>Linux</li>
      <li>Networking</li>
      <li>CI/CD</li>
      <li>Automation</li>
    </ul>
  </div>
  <div class="skill">
    <h3>Languages</h3>
    <ul>
      <li>Bash</li>
      <li>PHP</li>
      <li>Ruby</li>
      <li>TypeScript</li>
    </ul>
  </div>
  <div class="skill">
    <h3>Platforms</h3>
    <ul>
      <li>AWS</li>
      <li>Docker</li>
      <li>Kubernetes</li>
      <li>Azure</li>
    </ul>
  </div>
  <div class="skill">
    <h3>Tools</h3>
    <ul>
      <li>Ansible</li>
      <li>Terraform</li>
      <li>Packer</li>
      <li>GitOps</li>
    </ul>
  </div>
  <div class="skill">
    <h3>Process</h3>
    <ul>
      <li>Scrum</li>
      <li>Kanban</li>
      <li>DDD</li>
    </ul>
  </div>
</section>

<style>
  section.skills {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    padding: 0.5rem 0.5rem 1rem;
    margin-bottom: 0.5rem;
    justify-items: center;
  }

  h3 {
    font-size: 12pt;
  }

  @media (min-width: 480px) {
    section.skills {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 768px) {
    section.skills {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
    }
  }

  @media (min-width: 1024px) {
    section.skills {
      grid-template-columns: repeat(5, 1fr);
      gap: 1.5rem;
      padding: 0.5rem 1rem 1rem;
      margin-bottom: 0.5rem;
    }
  }

  @media print {
    section.skills {
      grid-template-columns: repeat(5, 1fr);
      margin: 0;
      gap: 0.8rem;
      padding: 0.3rem 0.5rem 0.6rem;
    }

    h3 {
      font-size: 10.5pt;
      margin-bottom: 0.15rem;
    }

    ul {
      margin: 0;
      padding-left: 1rem;
    }

    li {
      margin-bottom: 0.2rem;
      font-size: 9pt;
    }
  }
</style>

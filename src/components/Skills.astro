---
const skills: [string, string][] = [
  ["Platforms", "AWS, Azure, Kubernetes, Airflow, Dagster"],
  ["Infrastructure as Code", "Terraform, Ansible, Packer, CDKs"],
  ["CI/CD & GitOps", "GitHub Actions, GoCD, ArgoCD, FluxCD"],
  ["Observability", "Grafana LGTM, Graphite, OpenTelemetry, Datadog, Sentry"],
  ["Web & Networking", "NGINX, HAProxy, Varnish, Apache httpd, CDNs, DNS, TLS"],
  ["Data & Storage", "MySQL, Percona, MongoDB, Redis, Memcached"],
  ["Languages", "Bash, PHP, TypeScript, Ruby, R"],
];
---

<h2>Skills</h2>
<section class="skills">
  {
    skills.map(([category, items]) => (
      <Fragment>
        <div class="summary">{category}</div>
        <div class="items">{items}</div>
      </Fragment>
    ))
  }
</section>

<style>
  section.skills {
    display: grid;
    grid-template-columns: 1fr 3fr;
    column-gap: 1.5rem;
    row-gap: 0.5rem;
    align-items: start;
    margin-bottom: 0.5rem;
  }

  .summary {
    text-align: right;
    font-weight: 600;
    padding: 0.25rem 1rem 0.25rem 0.5rem;
  }

  .items {
    padding: 0.25rem 0;
    line-height: 1.5;
  }

  @media (max-width: 767px) {
    section.skills {
      grid-template-columns: 1fr;
      row-gap: 0.6rem;
    }

    .summary {
      text-align: center;
      padding: 0 0 0.15rem;
    }

    .items {
      padding: 0;
      text-align: center;
    }
  }

  @media print {
    section.skills {
      grid-template-columns: 1fr 3fr;
      column-gap: 1rem;
      row-gap: 0.15rem;
    }

    .summary {
      text-align: right;
      padding: 0.15rem 0.6rem 0.15rem 0.3rem;
    }

    .items {
      text-align: left;
      padding: 0.15rem 0;
    }
  }
</style>

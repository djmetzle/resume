---
const skills: [string, string][] = [
  ["Platforms", "AWS, Azure, Kubernetes, Airflow, Dagster"],
  ["Infrastructure as Code", "Terraform, Ansible, Packer, CDKs"],
  ["CI/CD & GitOps", "GitHub Actions, GoCD, ArgoCD, FluxCD"],
  ["Observability", "Grafana LGTM, Graphite, OpenTelemetry, Datadog, Sentry"],
  ["Web & Networking", "NGINX, HAProxy, Varnish, Apache httpd, CDNs, DNS, TLS"],
  ["Data & Storage", "MySQL, Percona, MongoDB, Redis, Memcached"],
  ["Languages", "Bash, PHP, TypeScript, Ruby, R"],
];
---

<h2>Skills</h2>
<table class="skills">
  <tbody>
    {
      skills.map(([category, items]) => (
        <tr>
          <th scope="row">{category}</th>
          <td>{items}</td>
        </tr>
      ))
    }
  </tbody>
</table>

<style>
  table.skills {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 0.5rem;
  }

  th,
  td {
    text-align: left;
    vertical-align: top;
    padding: 0.35rem 0.75rem 0.35rem 0;
    line-height: 1.5;
  }

  th[scope="row"] {
    white-space: nowrap;
    width: 1%;
    font-weight: 600;
    padding-right: 1.5rem;
  }

  @media (max-width: 600px) {
    table.skills,
    tbody,
    tr,
    th,
    td {
      display: block;
      width: auto;
    }

    tr {
      margin-bottom: 0.6rem;
    }

    th[scope="row"] {
      white-space: normal;
      width: auto;
      padding: 0 0 0.1rem;
    }

    td {
      padding: 0 0 0 0.5rem;
    }
  }

  @media print {
    tr {
      page-break-inside: avoid;
    }

    th,
    td {
      padding: 0.15rem 0.5rem 0.15rem 0;
    }

    th[scope="row"] {
      padding-right: 1rem;
    }
  }
</style>

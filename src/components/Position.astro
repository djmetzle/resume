---
const { company, position, timeperiod } = Astro.props;
---

<section class="position">
  <div class="summary">
    <h3>{company}</h3>
    <p>{position}</p>
    <p>{timeperiod}</p>
  </div>
  <div class="responsibilities">
    <ul>
      <slot />
    </ul>
  </div>
</section>

<style>
  section.position {
    display: grid;
    grid-template-columns: 1fr 3fr;
    gap: 1.5rem;
    margin-bottom: 1rem;
  }

  section.position:last-of-type {
    margin-bottom: 0;
  }

  .summary {
    text-align: right;
    padding: 0.5rem 1rem 0.5rem 0.5rem;
  }

  .responsibilities {
    padding: 0.5rem 0;
  }

  @media (max-width: 767px) {
    section.position {
      grid-template-columns: 1fr;
      gap: 0.5rem;
      margin-bottom: 1rem;
    }

    .summary {
      text-align: center;
      padding: 1rem 0.5rem;
      border-bottom: 1px solid;
      padding-bottom: 0.75rem;
    }
  }

  @media print {
    section.position {
      display: grid;
      grid-template-columns: 1fr 3fr;
      gap: 1rem;
      margin-bottom: 0.75rem;
      page-break-inside: avoid;
    }

    .summary {
      text-align: right;
      padding: 0.3rem 0.6rem 0.3rem 0.3rem;
      border-bottom: none;
    }

    .responsibilities {
      padding: 0.3rem 0;
    }
  }
</style>

---
import { Icon } from "astro-icon/components";
---

<hr />
<div class="aboutbar">
  <span>
    Made with: <a href="https://astro.build/"
      ><Icon name="simple-icons:astro" />Astro</a
    >
  </span>
  <span>
    Managed with: <a href="https://www.hashicorp.com/products/terraform"
      ><Icon name="simple-icons:terraform" />Terraform</a
    >
  </span>
  <span>
    Deployed with: <a href="https://github.com/features/actions"
      ><Icon name="simple-icons:github" />Github Actions</a
    >
  </span>
  <span>
    Hosted on: <a href="https://aws.amazon.com/"
      ><Icon name="lineicons:aws" />AWS</a
    >
  </span>

  <span>
    Source: <a href="https://github.com/djmetzle/resume">
      <Icon name="icomoon-free:github" />djmetzle/resume
    </a>
    <span>
      <div>
        <style>
          @media print {
            hr,
            .aboutbar {
              display: none;
            }
          }

          hr {
            margin: 1.5rem 0 1rem;
          }

          div {
            display: flex;
            justify-content: center;
            align-items: center;
            flex-wrap: wrap;
            gap: 0.35rem 0;
          }
          span {
            padding: 0 1em;
            display: inline-flex;
            align-items: center;
            gap: 0.25em;
          }
          a {
            display: inline-flex;
            align-items: center;
            gap: 0.25em;
          }
          [data-icon] {
            width: 16px;
            height: 16px;
            vertical-align: middle;
            display: inline-block;
          }
        </style>
      </div></span
    ></span
  >
</div>

---
import { Icon } from "astro-icon/components";
---

<hr />
<div class="aboutbar">
  <span>
    Made with: <a href="https://astro.build/"
      ><Icon name="simple-icons:astro" />Astro</a
    >
  </span>

  <span>
    <a href="https://github.com/djmetzle/resume">
      <Icon name="icomoon-free:github" />djmetzle/resume
    </a>
    <span>
      <div>
        <style>
          @media print {
            hr,
            .aboutbar {
              display: none;
            }
          }

          div {
            display: flex;
            justify-content: space-between;
          }
          span {
            padding: 0 1em;
          }
          [data-icon] {
            padding: 0 0.2em;
          }
        </style>
      </div></span
    ></span>
</div>

---
import { Icon } from "astro-icon/components";
---

<hr />
<div class="aboutbar">
  <span>
    Made with: <a href="https://astro.build/"
      ><Icon name="simple-icons:astro" />Astro</a
    >
  </span>

  <span>
    <a href="https://github.com/djmetzle/resume">
      <Icon name="icomoon-free:github" />djmetzle/resume
    </a>
    <span>
      <div>
        <style>
          @media print {
            hr,
            .aboutbar {
              display: none;
            }
          }

          hr {
            margin: 1.5rem 0 1rem;
          }

          div {
            display: flex;
            justify-content: space-between;
            align-items: center;
          }
          span {
            padding: 0 1em;
            display: inline-flex;
            align-items: center;
            gap: 0.25em;
          }
          a {
            display: inline-flex;
            align-items: center;
            gap: 0.25em;
          }
          [data-icon] {
            width: 16px;
            height: 16px;
            vertical-align: middle;
            display: inline-block;
          }
        </style>
      </div></span
    ></span>
</div>

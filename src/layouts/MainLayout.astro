---
import { SEO } from "astro-seo";

const { title } = Astro.props;
---

<html lang="en">
  <head>
    <SEO
      charset="utf-8"
      title="Daryl Metzler - Resume"
      description="Bespoke resume website, built with Astro"
      openGraph={{
        basic: {
          title: "Daryl Metzler - Resume",
          type: "profile",
          image: "https://avatars.githubusercontent.com/u/6876047",
        },
      }}
      extend={{
        link: [{ rel: "icon", href: "/favicon.ico" }],
      }}
    />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Source+Code+Pro:wght@200..900&display=swap"
      rel="stylesheet"
    />
    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>
  <body style="font-family: Source Code Pro">
    <main>
      <slot />
    </main>
  </body>
</html>

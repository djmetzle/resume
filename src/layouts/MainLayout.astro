---
import { SEO } from "astro-seo";

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Daryl Metzler",
  url: "https://resume.djmetzle.io/",
  image: "https://avatars.githubusercontent.com/u/6876047",
  email: "mailto:daryljmetzler@gmail.com",
  jobTitle: "DevOps Engineer",
  worksFor: {
    "@type": "Organization",
    name: "iFixit/Dozuki",
  },
  alumniOf: {
    "@type": "CollegeOrUniversity",
    name: "North Carolina State University",
  },
  sameAs: [
    "https://www.djmetzle.io",
    "https://github.com/djmetzle",
    "https://www.linkedin.com/in/djmetzle/",
  ],
  knowsAbout: [
    "DevOps",
    "Site Reliability Engineering",
    "AWS",
    "Linux",
    "Networking",
    "CI/CD",
    "Automation",
    "Terraform",
    "Ansible",
    "Docker",
    "Kubernetes",
  ],
};
---

<html lang="en">
  <head>
    <SEO
      charset="utf-8"
      title="Daryl Metzler - Resume"
      description="Resume of Daryl Metzler - DevOps / SRE / Cloud engineer. AWS, Linux, networking, CI/CD."
      openGraph={{
        basic: {
          title: "Daryl Metzler - Resume",
          type: "profile",
          image: "https://avatars.githubusercontent.com/u/6876047",
        },
        optional: {
          description:
            "Resume of Daryl Metzler - DevOps / SRE / Cloud engineer. AWS, Linux, networking, CI/CD.",
          siteName: "resume.djmetzle.io",
        },
        image: {
          type: "image/png",
          width: 256,
          height: 256,
          alt: "Daryl Metzler",
        },
      }}
      twitter={{
        card: "summary",
        title: "Daryl Metzler - Resume",
        description:
          "Resume of Daryl Metzler - DevOps / SRE / Cloud engineer. AWS, Linux, networking, CI/CD.",
        image: "https://avatars.githubusercontent.com/u/6876047",
        imageAlt: "Daryl Metzler",
      }}
      extend={{
        link: [{ rel: "icon", href: "/favicon.ico" }],
      }}
    />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Source+Code+Pro:wght@200..900&display=swap"
      rel="stylesheet"
    />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(personSchema)}
    />
  </head>
  <body style="font-family: Source Code Pro">
    <main>
      <slot />
    </main>
  </body>
</html>
